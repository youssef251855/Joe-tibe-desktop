{
  "name": "joetube-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:api && vite build",
    "build:api": "tsc -p backend/tsconfig.api.json",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "build:web": "vite build",
    "cap:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "desktop:install": "npm --prefix desktop install",
    "desktop:start": "npm run desktop:install && npm --prefix desktop run start",
    "desktop:dist": "npm run desktop:install && npm --prefix desktop run dist"
  },
  "dependencies": {
    "express": "^4.21.2",
    "youtubei.js": "^18.2.0",
    "yt-search": "^2.13.1",
    "undici": "^7.30.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.10",
    "@types/yt-search": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "@capacitor/cli": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
