{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022", "DOM"],
    "rootDir": "src/server",
    "outDir": "../api/_server",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts"]
}
